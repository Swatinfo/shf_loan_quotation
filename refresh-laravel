#!/bin/bash
# Refresh Laravel caches and autoloader
# Usage: refresh-laravel [-p php_version] [-d project_dir]
# Examples:
#   refresh-laravel                    # current dir, php8.4
#   refresh-laravel -p 8.3             # current dir, php8.3
#   refresh-laravel -d /path -p 8.3    # given dir, php8.3

# Defaults
PROJECT_DIR="$(pwd)"
PHP_VERSION="8.4"

# Parse flags in any order
while getopts "p:d:" opt; do
    case "$opt" in
        p) PHP_VERSION="$OPTARG" ;;
        d) PROJECT_DIR="$OPTARG" ;;
        *) echo "Usage: refresh-laravel [-p php_version] [-d project_dir]"; exit 1 ;;
    esac
done

# Strip a leading "php" if the user typed "-p php8.4" instead of "-p 8.4"
PHP_VERSION="${PHP_VERSION#php}"
PHP_BIN="php${PHP_VERSION}"

# Make sure that PHP binary actually exists
if ! command -v "$PHP_BIN" >/dev/null 2>&1; then
    echo "PHP binary '$PHP_BIN' not found. Is that version installed?"
    exit 1
fi

cd "$PROJECT_DIR" || { echo "Cannot cd to $PROJECT_DIR"; exit 1; }

echo ">> Using $PHP_BIN in $PROJECT_DIR"

echo ">> Clearing Laravel caches"
"$PHP_BIN" artisan optimize:clear

echo ">> Dumping optimized autoloader"
"$PHP_BIN" /usr/local/bin/composer dump-autoload -o

echo ">> Clearing nginx cache + restarting nginx/apache"
sudo sh -c '/bin/rm -rf /var/cache/nginx/*' && sudo service nginx restart && sudo service apache2 restart

echo ">> Done."
